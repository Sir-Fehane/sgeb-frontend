# Committed, non-secret environment values used ONLY when running the test
# suite (Vitest defaults to `mode: 'test'`, so Vite's standard env-loading
# convention picks this file up automatically — see
# https://vitejs.dev/guide/env-and-mode.html). This lets `pnpm test:run`
# execute deterministically on a fresh clone and in CI without anyone
# creating a local `.env` first.
#
# These are placeholder endpoint URLs, not credentials — no test in this
# repository makes a real network call to them (Axios/HTTP is always
# mocked or dependency-injected in tests). Do not add secrets to this file;
# it is intentionally tracked in git, unlike `.env`/`.env.local`.
#
# Only variables `src/shared/config/env.ts` actually validates are listed
# here — OIDC config (`src/features/oidc-client/config/oidcConfig.ts`) is
# validated lazily per-call and every test that needs it already supplies
# its own explicit values, so it is deliberately NOT duplicated here.
VITE_SGEB_API_URL=http://localhost:3333/v1
VITE_SSO_API_URL=http://localhost:3333

# Placeholder public token so the Salón location picker's default test path
# exercises the real map/geocoding UI instead of its "token missing"
# fallback. `mapbox-gl` itself is always mocked in tests
# (`shared/components/ui/mapbox-map.test.tsx`) — this value never reaches
# a real Mapbox request.
VITE_MAPBOX_ACCESS_TOKEN=pk.test-token
