# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file — it is already covered by .gitignore.

# Base URL of the SGEB business API (docs/api/).
VITE_SGEB_API_URL=https://api.sgeb.mediocres.mx/v1

# Base URL of the independent SSO service (docs/sso/).
VITE_SSO_API_URL=https://api.sgeb.mediocres.mx/v1

# OIDC client configuration for the panel's own protocol client
# (src/features/oidc-client/) — public PKCE client, no secret. See
# ADR-002 in docs/decisions.md.

# The provider's issuer URL.
VITE_OIDC_ISSUER=https://auth.sgeb.mediocres.mx

# Registered client_id for this web panel.
VITE_OIDC_CLIENT_ID=sgeb-web-panel

# Must exactly match a redirect_uri registered for this client.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Must exactly match a post_logout_redirect_uri registered for this client.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Space-separated scope. openapi-sso.yaml only documents this combination
# as an *example*, not a confirmed registered value — confirm with the
# SSO team before changing it in a real environment.
VITE_OIDC_SCOPE=openid perfil sgeb.api

# Public Mapbox access token for the Salón location picker (map + forward
# geocoding, src/features/events/components/SalonLocationPicker.tsx).
# Optional: without it the picker shows a "mapa no disponible" state
# instead of crashing the Salón form.
#
# Use a PUBLIC token (pk.*), never a secret token — this is sent from the
# browser. In the Mapbox dashboard, scope this token's URL restrictions to:
#   - local:      http://localhost:5173/*
#   - production: the deployed panel's real origin(s) only
# VITE_MAPBOX_ACCESS_TOKEN=pk.your-public-token
